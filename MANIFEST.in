include CHANGELOG.md
include CONTRIBUTING.md
include LICENSE
include MANIFEST.in
include README.md
include README.zh-CN.md
include SECURITY.md
include SUPPORT_MATRIX.md
include THIRD_PARTY_NOTICES.md
include THREAT_MODEL.md

recursive-include .github/scripts *.py
recursive-include .github/workflows *.yml
recursive-include docs *.md
recursive-include schemas *.json
include skills/sharesafe/SKILL.md
recursive-include skills/sharesafe/agents *.yaml
recursive-include skills/sharesafe/references *.md
include skills/sharesafe/scripts/run_sharesafe.py
recursive-include tests *.py

prune .pytest_cache
prune .pytest-tmp
global-exclude __pycache__
global-exclude *.py[cod]
global-exclude .DS_Store
